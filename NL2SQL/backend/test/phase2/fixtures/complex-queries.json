        "coreTableCount": { "min": 1 }
      },
      "sqlKeywords": {
        "required": ["GROUP BY", "COUNT", "create_time", "LIMIT"],
        "forbidden": ["DELETE", "UPDATE", "DROP", "INSERT"]
      },
      "resultAssertions": { "mode": "DRY_RUN" }
    },
    {
      "id": "c2",
      "category": "multi-dim-filter",
