      "tablesCalled": {
        "mustInclude": ["tzpingtai_tz_sdk_log_pf_reg"],
        "maxSize": 8,
        "coreTableCount": { "min": 1 }
      },
      "sqlKeywords": {
        "required": ["GROUP BY", "game_id", "LIMIT"],
        "forbidden": ["DELETE", "UPDATE", "DROP"]
      },
      "resultAssertions": { "mode": "DRY_RUN" }
    },
    {
