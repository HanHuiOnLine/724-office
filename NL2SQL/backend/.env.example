# ============================================
# NL2SQL 服务环境变量配置示例
# 复制此文件为 .env 并填写实际配置值
# ============================================

# --------------------------------------------
# 服务基础配置
# --------------------------------------------

# 服务监听的端口号，默认3000
PORT=3000

# 服务运行环境，development 或 production
NODE_ENV=development

# --------------------------------------------
# LLM API 配置
# --------------------------------------------

# LLM API的基础URL，支持OpenAI格式
# 例如：https://api.openai.com/v1 或 https://api.deepseek.com/v1
LLM_API_BASE=https://api.openai.com/v1

# LLM API密钥
LLM_API_KEY=your-api-key-here

# 默认使用的模型名称
LLM_MODEL=gpt-4

# Embedding模型名称，用于向量检索
EMBEDDING_MODEL=text-embedding-3-small

# --------------------------------------------
# 数据库配置
# --------------------------------------------

# SQLite数据库文件路径，存储会话和查询历史
DB_PATH=./data/sessions.db

# LanceDB向量数据库目录路径
VECTOR_DB_PATH=./data/vectordb

# SR数据源数据库连接字符串（只读）
# 格式：mysql://user:password@host:port/database
SR_DATABASE_URL=mysql://readonly_user:password@localhost:3306/sr_db

# --------------------------------------------
# 安全配置
# --------------------------------------------

# 允许查询的数据表白名单，多个表用逗号分隔
# 例如：sales_order,users,products
ALLOWED_TABLES=sales_order,users,region,products

# 单个查询返回的最大行数限制
MAX_QUERY_ROWS=1000

# 查询超时时间（毫秒）
QUERY_TIMEOUT=30000

# --------------------------------------------
# 日志配置
# --------------------------------------------

# 日志级别：debug, info, warn, error
LOG_LEVEL=info

# 日志文件路径
LOG_FILE=./logs/app.log

# --------------------------------------------
# Schema配置
# --------------------------------------------

# 是否强制重新向量化Schema，true=每次启动都重新生成向量，false=向量已存在则跳过
# 开发环境建议设为false以加快启动速度，Schema变更时临时设为true
SCHEMA_REVECTORIZE=false

# --------------------------------------------
# 上下文管理配置（新增）
# --------------------------------------------

# 是否启用Token预算检查，true=启用，false=禁用
ENABLE_TOKEN_BUDGET=true

# 是否启用对话摘要，true=启用，false=禁用
ENABLE_SUMMARIZER=true

# 最大上下文Token数（默认128k的80%）
MAX_CONTEXT_TOKENS=102400

# 为模型输出预留的Token数
RESERVED_OUTPUT_TOKENS=8192

# 触发对话摘要的对话轮数阈值
SUMMARIZER_TRIGGER_ROUNDS=8

# 摘要保留的最近对话轮数
SUMMARIZER_PRESERVE_ROUNDS=4

# 摘要的最大Token数
SUMMARIZER_MAX_TOKENS=500
