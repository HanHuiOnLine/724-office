# ============================================
# NL2SQL 服务环境变量配置示例
# 复制此文件为 .env 并填写实际配置值
# ============================================

# --------------------------------------------
# 服务基础配置
# --------------------------------------------

# 服务监听的端口号，默认3000
PORT=3000

# 服务运行环境，development 或 production
NODE_ENV=development

# --------------------------------------------
# LLM API 配置
# --------------------------------------------

# LLM API的基础URL，支持OpenAI格式
# 例如：https://api.openai.com/v1 或 https://api.deepseek.com/v1
LLM_API_BASE=https://api.openai.com/v1

# LLM API密钥
LLM_API_KEY=your-api-key-here

# 默认使用的模型名称
LLM_MODEL=gpt-4

# Embedding模型名称，用于向量检索
EMBEDDING_MODEL=text-embedding-3-small

# 是否启用 Embedding 向量检索，false 时跳过相似查询检索/写入分支
EMBEDDING_ENABLED=true

# Embedding 向量维度，需与模型匹配
EMBEDDING_DIMENSION=1536

# --------------------------------------------
# 数据库配置
# --------------------------------------------

# SQLite数据库文件路径，存储会话和查询历史
DB_PATH=./data/sessions.db

# LanceDB向量数据库目录路径
VECTOR_DB_PATH=./data/vectordb

# SR数据源数据库连接字符串（只读）
# 格式：mysql://user:password@host:port/database
SR_DATABASE_URL=mysql://readonly_user:password@localhost:3306/sr_db

# 是否启用 SR 数据源真实执行，false 时 executeQuery 返回 SR_DB_NOT_CONFIGURED
# 默认依据 SR_DATABASE_URL 自动推断（非空即启用）
SR_DB_ENABLED=true

# SR 单条 SQL 最大执行时长（毫秒）
SR_QUERY_TIMEOUT_MS=30000

# SR 单次返回最大行数，超过则截断并在 data.truncated=true 中提示
SR_MAX_ROWS=1000

# 是否只生成 SQL 不实际执行真实库（开发调试兜底开关）
DRY_RUN=false

# --------------------------------------------
# 安全配置
# --------------------------------------------

# 允许查询的数据表白名单，多个表用逗号分隔
# 例如：sales_order,users,products
ALLOWED_TABLES=sales_order,users,region,products

# 单个查询返回的最大行数限制
MAX_QUERY_ROWS=1000

# 查询超时时间（毫秒）
QUERY_TIMEOUT=30000

# --------------------------------------------
# 日志配置
# --------------------------------------------

# 日志级别：debug, info, warn, error
LOG_LEVEL=info

# 日志文件路径
LOG_FILE=./logs/app.log

# --------------------------------------------
# Schema配置
# --------------------------------------------

# 是否强制重新向量化Schema，true=每次启动都重新生成向量，false=向量已存在则跳过
# 开发环境建议设为false以加快启动速度，Schema变更时临时设为true
SCHEMA_REVECTORIZE=false

# --------------------------------------------
# 上下文管理配置（新增）
# --------------------------------------------

# 是否启用Token预算检查，true=启用，false=禁用
ENABLE_TOKEN_BUDGET=true

# 是否启用对话摘要，true=启用，false=禁用
ENABLE_SUMMARIZER=true

# 最大上下文Token数（默认128k的80%）
MAX_CONTEXT_TOKENS=102400

# 为模型输出预留的Token数
RESERVED_OUTPUT_TOKENS=8192

# 触发对话摘要的对话轮数阈值
SUMMARIZER_TRIGGER_ROUNDS=8

# 摘要保留的最近对话轮数
SUMMARIZER_PRESERVE_ROUNDS=4

# 摘要的最大Token数
SUMMARIZER_MAX_TOKENS=500

# --------------------------------------------
# 评估配置（新增）
# --------------------------------------------

# 是否启用向量化质量评估功能，true=启用，false=禁用（默认）
EVALUATION_ENABLED=false

# 是否记录运行时统计（向量检索命中率、记忆命中率），true=启用，false=禁用（默认）
EVALUATION_TRACK_STATS=false

# --------------------------------------------
# Phase 2 功能开关
# --------------------------------------------

# 【Phase 2】统一表候选打分器（默认启用）
# 启用: 融合向量/语义/关键词/核心表加权,核心表保护+上限 8
# 回滚: FF_UNIFIED_RANKER=false 退回老的 Set 合并 + slice(0,5) 行为
FF_UNIFIED_RANKER=true

# --------------------------------------------
# Phase 3 功能开关
# --------------------------------------------

# 【Phase 3 · T1】是否启用 Agentic 引擎入口
# 启用后 sseHandler.handleQuery 会优先走 agenticEngine,失败回退 legacy
FF_AGENTIC_ENGINE=false

# 【Phase 3 · T1】Agentic 引擎失败是否自动回退 legacy(反向开关,默认 true)
# 设 false 时 agentic 失败会直接抛 error 到前端,便于排障
FF_AGENTIC_AUTO_FALLBACK=true

# 【Phase 3 · T3a】结果脱敏(反向开关,默认 true)
# 启用后 executeQuery 返回前按 config.security.masking.rules 对 phone/email/id_card/token 等列脱敏
# 紧急关闭:FF_RESULT_MASKING=false
FF_RESULT_MASKING=true

# 【Phase 3 · T3a】脱敏细粒度关闭(config.security.masking.enabled)
# 两级开关:FF_RESULT_MASKING 控 FF 层;MASKING_ENABLED 控 config 层;任一为 false 即不脱敏
# MASKING_ENABLED=true

# 【Phase 3 · T3b】行级权限(RLS)SQL 改写(默认关闭,最高风险项)
# 正向开关,需显式启用。启用后 validateSQL 通过、executeQuery 之前,对映射中的表注入 tenant_id 过滤
# 依赖:请求必须带 X-Tenant-Id header;RLS_TABLE_TENANT_MAP 需配置;Parser 解析失败会硬拒 SQL
FF_RLS_ENFORCEMENT=false

# 【Phase 3 · T3b】RLS 配置层开关(两级,与 FF 相 AND)
RLS_ENABLED=false

# 【Phase 3 · T3b】表→租户列 映射,格式 "t1:tenant_col,t2:tenant_col"
# 为空时 rls 不保护任何表,即便 FF+enabled=true 也放行
# RLS_TABLE_TENANT_MAP=orders:tenant_id,users:tenant_id

# 【Phase 3 · T3c】query_history 扩展审计字段写入(反向开关,默认 true)
# 包含 user_role / tenant_id / request_source / request_ip / error_code / fallback_used / rls_applied
# 紧急关闭:FF_AUDIT_LOG_EXTENDED=false
FF_AUDIT_LOG_EXTENDED=true

# 【Phase 3 · T2】调试逃生门:是否在 console 打印完整 Prompt(默认关闭)
# 仅 dev 排障时临时开启,生产务必保持未设置或 false
# LOG_PROMPT_FULL=false
